# Public site configuration
NEXT_PUBLIC_SITE_URL=https://native-connects-<hash>-<region>.a.run.app

# Server-only Google Apps Script webhook for contact, demo and chat leads
CONTACT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Server-only OpenAI-compatible LLM settings. NEVER use NEXT_PUBLIC_ for the key.
LLM_API_KEY=your-llm-api-key
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.5-flash
